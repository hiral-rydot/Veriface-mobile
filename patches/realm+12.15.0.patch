+        <ImageView
+              android:id="@+id/scrollIndicatorDown"
+              android:layout_width="match_parent"
+              android:layout_height="1dp"
+              android:layout_gravity="bottom"
+              android:background="#1f000000"
+              app:backgroundTint="?android:attr/colorForeground"
